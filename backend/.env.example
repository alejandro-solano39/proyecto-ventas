# Servidor
PORT=3000
NODE_ENV=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# Opción A: Supabase (recomendado)
# Ve a: supabase.com → tu proyecto → Settings → Database → Connection string → URI
# Pega aquí la connection string (modo "Transaction" para serverless):
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Opción B: PostgreSQL local (alternativa)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ventas_hoteleras
# DB_USER=postgres
# DB_PASSWORD=tu_password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_muy_largo_y_seguro_123456

# ── Transcripción de audio ───────────────────────────────────────────────────
# OpenAI Whisper — obtén tu key en: platform.openai.com/api-keys
# Costo: ~$0.006 USD por minuto de audio (muy barato para demo)
OPENAI_API_KEY=sk-...

# ── Extracción de entidades con IA ───────────────────────────────────────────
# Anthropic Claude — obtén tu key en: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
